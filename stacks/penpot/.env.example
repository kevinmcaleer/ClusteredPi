# Cloudflare Tunnel token for the penpot tunnel.
# Create a tunnel in the Cloudflare Zero Trust dashboard (Networks > Tunnels),
# add a public hostname penpot.kevsrobots.com -> http://penpot-frontend:8080,
# then copy the tunnel token here.
TUNNEL_TOKEN=your-tunnel-token-here

# Public URL penpot will report itself as (used for links/redirects).
PENPOT_PUBLIC_URI=https://penpot.kevsrobots.com

