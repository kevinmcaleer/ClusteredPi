# syntax=docker/dockerfile:1.4
# Enable BuildKit for cache mounts

# Stage 1: Fetch repository
FROM alpine:latest AS getfiles

# Install git (Alpine is much smaller than Ubuntu)
RUN apk add --no-cache git

# Clone repository with minimal depth
WORKDIR /src

# Auto-bust the git-clone layer when main has new commits. The
# response body changes on every push, so Docker invalidates this
# layer (and everything after it) without needing --no-cache or a
# manual --build-arg CACHE_DATE=...
#
# NOTE: do NOT switch this to api.github.com/repos/.../commits/main —
# that endpoint is rate-limited to 60 anonymous req/hr per IP, and the
# build Pi will exhaust that quickly, breaking every subsequent build
# with "failed to load cache key: invalid response status 403".
# github.com/.../commits/main.atom returns the same per-commit-changing
# content but is regular site traffic and not subject to that limit.
ADD https://github.com/kevinmcaleer/kevsrobots.com/commits/main.atom /tmp/main-sha.xml

# Manual override still available — `--build-arg CACHE_DATE=$(date)`
ARG CACHE_DATE=1

RUN git clone --depth=1 \
    https://www.github.com/kevinmcaleer/kevsrobots.com.git \
    --recurse-submodules --remote-submodules

# Stage 2: Build Jekyll site
FROM ruby:3.2-alpine AS jekyll_build

# Install build dependencies (Alpine packages are smaller/faster)
RUN apk add --no-cache \
    build-base \
    zlib-dev \
    libffi-dev \
    libxml2-dev \
    libxslt-dev

# Install gems BEFORE copying the site. Nothing above this line depends on
# the repository contents, so these layers stay cached across content
# commits: a routine rebuild skips the ~1-2 minute native-extension compile
# (nokogiri, sass-embedded, protobuf, ffi) and goes straight to the Jekyll
# build. Previously the COPY came first, so every new commit on main
# invalidated the gem layer and reinstalled all 42 gems from scratch.
RUN gem install \
    jekyll:4.3.3 \
    jekyll-redirect-from \
    kramdown \
    rdiscount \
    rouge \
    byebug \
    jekyll-sass-converter:3.0.0 \
    sass-embedded:1.64.1 \
    nokogiri \
    google-protobuf:3.25.2 \
    --no-document

# Set working directory
WORKDIR /src

# Copy only the web directory (not entire repo)
COPY --from=getfiles /src/kevsrobots.com/web /src

# JEKYLL_ENV is read at build time, not at run time. docker-compose sets it
# on the service, which never reaches `jekyll build`; set it here so
# {% if jekyll.environment == "production" %} blocks render in the image.
ENV JEKYLL_ENV=production

# Build the Jekyll site
RUN jekyll build --trace

# Stage 3: Production nginx server
FROM nginx:alpine

# Copy optimized nginx configuration from build context
COPY nginx-optimized.conf /etc/nginx/nginx.conf

# Copy built site from Jekyll stage, owned by nginx at copy time.
# A separate `RUN chown -R ... && chmod -R ...` rewrites every file into a
# second ~1.1 GB layer (the image was ~2.5 GB for a 1.1 GB site) and takes
# ~15 s on a Pi. COPY --chown sets ownership in the same layer for free.
# Jekyll already writes files 644 and directories 755, which is all nginx
# needs to read them.
COPY --from=jekyll_build --chown=nginx:nginx /src/_site /www/data

# Healthcheck (longer start-period for Raspberry Pi)
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:3333/health || exit 1

# Expose port
EXPOSE 3333

# Labels for metadata
LABEL maintainer="kevinmcaleer@gmail.com"
LABEL description="KevsRobots website - optimized for Raspberry Pi 5 (ARM64)"
LABEL version="2.1-cached-gems"

# Start nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
